{
  "expo": {
    "name": "Warehouse Inventory",
    "slug": "mmt-pune",
    "owner": "sameerjadhavs-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.airport.warehouseinventory",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Warehouse Inventory to scan barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Warehouse Inventory to attach item photos."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "apiUrl": "https://mmt.labxco.cloud/api",
      "preferRemoteApiInDev": false,
      "eas": {
        "projectId": "39dd6915-5ca0-4606-9d65-d6bd40686771"
      }
    }
  }
}
