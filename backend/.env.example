# LOCAL DEV ONLY — never commit real .env. Production secrets belong in Dokploy Environment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=True
# Include your PC LAN IP for Expo Go (e.g. 192.168.x.x). DEBUG mode also allows *.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production also needs:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mmt.labxco.cloud


# Use PostgreSQL in normal development/production. Set DJANGO_USE_SQLITE=1 only for local tests without Docker.
# DJANGO_USE_SQLITE=0

DATABASE_URL=postgres://warehouse:warehouse_pass@127.0.0.1:5432/warehouse_inventory
DB_NAME=warehouse_inventory
DB_USER=warehouse
DB_PASSWORD=warehouse_pass
DB_HOST=127.0.0.1
DB_PORT=5432

COMPANY_NAME=Airport Equipment Manufacturing
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
